# =============== Доступ к панели ===============
# Пароль для входа: 4–6 символов, латинские буквы и/или цифры
APP_PASSWORD=1234
# Домен, на котором будет открываться панель (Caddy сам получит SSL)
PANEL_DOMAIN=cheker.example.com
# Сессия живёт N дней
SESSION_TTL_DAYS=7
# true — cookie только по HTTPS. Для локального запуска без HTTPS поставьте false
COOKIE_SECURE=true

# Защита от перебора пароля
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
LOGIN_GLOBAL_MAX_FAILURES=30
LOGIN_GLOBAL_LOCK_MINUTES=30

# Часовой пояс (для ежедневной сводки)
TZ=Europe/Moscow
