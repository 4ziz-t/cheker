# =============== Доступ к панели ===============
# Пароль для входа: 4–6 символов, латинские буквы и/или цифры
APP_PASSWORD=1234
# Домен, на котором будет открываться панель (Caddy сам получит SSL)
PANEL_DOMAIN=cheker.example.com
# Сессия живёт N дней
SESSION_TTL_DAYS=7
# true — cookie только по HTTPS. Для локального запуска без HTTPS поставьте false
COOKIE_SECURE=true

# Защита от перебора пароля
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
LOGIN_GLOBAL_MAX_FAILURES=30
LOGIN_GLOBAL_LOCK_MINUTES=30

# Часовой пояс (для ежедневной сводки)
TZ=Europe/Moscow

# ----------------------------------------------------------------------
# Токены и адреса ниже можно НЕ заполнять здесь, а указать в панели:
# Настройки → Интеграции. Значение из панели важнее, чем из .env.
# ----------------------------------------------------------------------

# =============== Remnawave ===============
# Адрес панели, например https://panel.example.com
REMNAWAVE_URL=
# API токен: панель → Настройки → API Tokens
REMNAWAVE_TOKEN=
# Необязательно: X-Api-Key, если панель закрыта доп. защитой на Caddy
REMNAWAVE_API_KEY=

# =============== Cloudflare ===============
# API Token с правами: Zone → Zone → Read и Zone → DNS → Edit (для нужных зон)
CLOUDFLARE_API_TOKEN=

# =============== Telegram ===============
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш chat_id (узнать можно у @userinfobot). Перед этим напишите боту /start
TELEGRAM_CHAT_ID=

# =============== Cheburcheck ===============
# API-токен для динамической проверки (пробы из РФ, ловят ТСПУ).
# Выдаётся по заявке: https://cheburcheck.ru/kb/api . Без токена работает только проверка по реестру РКН
CHEBURCHECK_TOKEN=
# Сколько секунд ждать ответы проб
CHEBURCHECK_PROBE_TIMEOUT=120

# =============== GeoPinger ===============
# API-токен geopinger.net (Профиль → API). Нужен для TCP-проверки с узлов в РФ
GEOPINGER_TOKEN=

# =============== Прочее ===============
LOG_LEVEL=INFO
HTTP_TIMEOUT=20
